# Supabase — client-safe credentials (EXPO_PUBLIC_ prefix bundles them into the app)
# Copy this file to .env and fill in the real values. Never commit .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Dead-man's switch delivery escrow public key (safe to bundle in app)
EXPO_PUBLIC_ESCROW_PUBLIC_KEY=

# NOTE: The service_role key & escrow private key must NEVER appear here or in src/.
# Store them only as Supabase Edge Function secrets:
#   npx supabase secrets set SERVICE_ROLE_KEY=<value>
#   npx supabase secrets set ESCROW_PRIVATE_KEY=<value>
