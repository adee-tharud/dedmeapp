# Supabase — client-safe credentials (EXPO_PUBLIC_ prefix bundles them into the app)
# Copy this file to .env and fill in the real values. Never commit .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: The service_role key must NEVER appear here or anywhere in src/.
# Store it only as a Supabase Edge Function secret:
#   npx supabase secrets set SERVICE_ROLE_KEY=<value>
